{
  "name": "numa-shared",
  "private": true,
  "type": "module",
  "scripts": {
    "branding:test": "node --test scripts/tests/branding-contract-test.mjs",
    "hygiene:test": "node --test scripts/tests/public-hygiene-test.mjs",
    "build:home": "node scripts/build-home.mjs",
    "build:home:check": "node scripts/build-home.mjs --check",
